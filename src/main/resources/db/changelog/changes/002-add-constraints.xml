<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-unique-client-email" author="lina">
        <addUniqueConstraint
                tableName="clients"
                columnNames="email"
                constraintName="uk_clients_email"/>
    </changeSet>

    <changeSet id="005-unique-account-number" author="lina">
        <addUniqueConstraint
                tableName="accounts"
                columnNames="account_number"
                constraintName="uk_accounts_account_number"/>
    </changeSet>

    <changeSet id="006-fk-accounts-clients" author="lina">
        <addForeignKeyConstraint
                baseTableName="accounts"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_accounts_clients"/>
    </changeSet>

    <changeSet id="007-fk-transactions-accounts" author="lina">
        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="account_id"
                referencedTableName="accounts"
                referencedColumnNames="id"
                constraintName="fk_transactions_accounts"/>
    </changeSet>

</databaseChangeLog>